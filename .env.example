# Copy this file to .env for local development. On Vercel, set the same names
# under Project -> Settings -> Environment Variables (and redeploy).
#
# None of these are public/client-prefixed. Every one is read only inside server
# functions, so none of them belongs in the browser bundle — if one ever shows up
# in a built client chunk, that is a bug worth stopping for.

# The Neon connection string, copied from the Neon dashboard's "Connect" panel.
# It looks like:
#
#   postgresql://<user>:<password>@<host>/<database>?sslmode=require
#
# This carries the database password. Unlike the Supabase service-role key it
# replaced, it is not a token that can be scoped or rotated without also
# changing this variable — so treat it as the secret it is, and never paste it
# into a chat, an issue or a commit.
DATABASE_URL=

# The password for /admin. Length matters more than punctuation here — a long
# passphrase beats a short scrambled one.
ADMIN_PASSWORD=

# Signs the admin session cookie. Any long random string.
# Generate one with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# Salt for hashing reviewer IP addresses before they are stored. Any long random
# string. The raw IP is never written to the database — only this hash, which is
# all the rate limiter needs.
IP_HASH_SALT=
